<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1200" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgCircle" cx="50%" cy="45%" r="50%">
      <stop offset="0%" stop-color="#232427" />
      <stop offset="85%" stop-color="#141517" />
      <stop offset="100%" stop-color="#0c0d0e" />
    </radialGradient>

    <!-- Sunglasses Lens Gradient (Dark on top, lighter on bottom) -->
    <linearGradient id="sunglassLens" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#343639" />
      <stop offset="45%" stop-color="#46484c" />
      <stop offset="100%" stop-color="#83868c" />
    </linearGradient>

    <!-- Subtle Hair Depth Gradient -->
    <linearGradient id="hairFill" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#73767c" />
      <stop offset="100%" stop-color="#5a5d62" />
    </linearGradient>

    <!-- Skin Fill -->
    <linearGradient id="skinFill" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#e1e3e6" />
      <stop offset="100%" stop-color="#d4d6da" />
    </linearGradient>

    <!-- Shirt Fill -->
    <linearGradient id="shirtFill" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#cfd1d5" />
      <stop offset="100%" stop-color="#c1c3c7" />
    </linearGradient>

    <!-- Tongue Fill -->
    <linearGradient id="tongueFill" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#6f7278" />
      <stop offset="100%" stop-color="#5a5d63" />
    </linearGradient>
  </defs>

  <!-- Dark Background Canvas -->
  <rect width="1000" height="1200" fill="#121315" />

  <!-- Outer Dark Vignette Halo Frame -->
  <circle cx="500" cy="520" r="480" fill="url(#bgCircle)" />
  <circle cx="500" cy="520" r="475" fill="none" stroke="#222427" stroke-width="8" opacity="0.6" />

  <!-- ==================== AVATAR BODY & HAIR ==================== -->
  <g id="illustration" transform="translate(0, 10)">
    
    <!-- BACK HAIR SILHOUETTE -->
    <!-- Smooth rounded dome on top with straight sides hanging down -->
    <path d="
      M 190 400 
      C 180 120, 820 120, 810 400 
      C 805 520, 805 700, 800 850 
      C 800 880, 770 900, 740 890 
      C 730 830, 725 650, 720 540 
      L 280 540 
      C 275 650, 270 830, 260 890 
      C 230 900, 200 880, 200 850 
      C 195 700, 195 520, 190 400 Z" 
      fill="url(#hairFill)" 
    />

    <!-- SHIRT / TORSO -->
    <path d="
      M 100 1150 
      C 105 920, 260 800, 500 800 
      C 740 800, 895 920, 900 1150 Z" 
      fill="url(#shirtFill)" 
    />

    <!-- T-SHIRT CREW NECK COLLAR BAND -->
    <path d="
      M 345 805 
      C 345 910, 655 910, 655 805" 
      fill="none" 
      stroke="#b2b5ba" 
      stroke-width="26" 
      stroke-linecap="round" 
    />
    <path d="
      M 355 805 
      C 355 895, 645 895, 645 805" 
      fill="none" 
      stroke="#cfd1d5" 
      stroke-width="12" 
      stroke-linecap="round" 
    />

    <!-- NECK -->
    <path d="
      M 410 600 
      L 410 820 
      C 460 835, 540 835, 590 820 
      L 590 600 Z" 
      fill="#c2c5ca" 
    />
    <path d="
      M 410 600 
      L 410 770 
      C 460 795, 540 795, 590 770 
      L 590 600 Z" 
      fill="url(#skinFill)" 
    />

    <!-- HEAD & FACE BASE (Curved jaw and cheeks) -->
    <path d="
      M 225 390 
      C 220 230, 780 230, 775 390 
      C 775 560, 700 720, 500 720 
      C 300 720, 225 560, 225 390 Z" 
      fill="url(#skinFill)" 
    />

    <!-- FRONT HAIR / BANGS & SIDE TRESSES -->
    <!-- Left hair drape -->
    <path d="
      M 230 380 
      C 220 500, 210 650, 260 860 
      C 270 870, 290 860, 295 830 
      C 300 680, 295 520, 310 400 
      Z" 
      fill="url(#hairFill)" 
    />
    
    <!-- Right hair drape -->
    <path d="
      M 770 380 
      C 780 500, 790 650, 740 860 
      C 730 870, 710 860, 705 830 
      C 700 680, 705 520, 690 400 
      Z" 
      fill="url(#hairFill)" 
    />

    <!-- Forehead Bangs with characteristic soft center triangle cut -->
    <path d="
      M 230 380 
      C 225 200, 775 200, 770 380 
      C 740 310, 680 260, 600 290 
      C 550 310, 520 280, 500 240 
      C 480 280, 450 310, 400 290 
      C 320 260, 260 310, 230 380 Z" 
      fill="url(#hairFill)" 
    />

    <!-- Additional hair strand notch accents for exact visual texture -->
    <path d="M 440 270 L 465 315 L 435 300 Z" fill="url(#hairFill)" />
    <path d="M 560 270 L 535 315 L 565 300 Z" fill="url(#hairFill)" />

    <!-- ==================== FACIAL FEATURES ==================== -->

    <!-- EYEBROWS (Cute slightly arched / angled eyebrows above sunglasses) -->
    <!-- Left eyebrow -->
    <path d="M 430 310 C 445 288, 465 292, 460 316" fill="none" stroke="#383a3e" stroke-width="12" stroke-linecap="round" />
    <!-- Right eyebrow -->
    <path d="M 570 310 C 555 288, 535 292, 540 316" fill="none" stroke="#383a3e" stroke-width="12" stroke-linecap="round" />

    <!-- SUNGLASSES (Identical shape to the reference) -->
    <g id="sunglasses">
      <!-- Side temple stems going back -->
      <path d="M 190 395 L 245 385" stroke="#7e8187" stroke-width="14" stroke-linecap="round" />
      <path d="M 810 395 L 755 385" stroke="#7e8187" stroke-width="14" stroke-linecap="round" />

      <!-- Left Outer Frame Rim -->
      <path d="
        M 275 345 
        C 335 335, 465 340, 480 360 
        C 495 380, 490 470, 455 495 
        C 415 525, 305 525, 275 480 
        C 255 450, 250 365, 275 345 Z" 
        fill="#7f8288" 
        stroke="#6e7177" 
        stroke-width="4"
      />

      <!-- Right Outer Frame Rim -->
      <path d="
        M 725 345 
        C 665 335, 535 340, 520 360 
        C 505 380, 510 470, 545 495 
        C 585 525, 695 525, 725 480 
        C 745 450, 750 365, 725 345 Z" 
        fill="#7f8288" 
        stroke="#6e7177" 
        stroke-width="4"
      />

      <!-- Center Bridge -->
      <path d="M 470 375 C 490 365, 510 365, 530 375" fill="none" stroke="#7f8288" stroke-width="20" stroke-linecap="round" />

      <!-- Left Lens (Gradient Glass) -->
      <path d="
        M 292 360 
        C 340 350, 445 355, 460 375 
        C 475 395, 470 455, 440 478 
        C 405 502, 318 502, 292 468 
        C 275 440, 272 375, 292 360 Z" 
        fill="url(#sunglassLens)" 
      />

      <!-- Right Lens (Gradient Glass) -->
      <path d="
        M 708 360 
        C 660 350, 555 355, 540 375 
        C 525 395, 530 455, 560 478 
        C 595 502, 682 502, 708 468 
        C 725 440, 728 375, 708 360 Z" 
        fill="url(#sunglassLens)" 
      />
    </g>

    <!-- NOSE (Curved smooth arc with subtle shading) -->
    <path d="M 472 505 C 485 525, 515 525, 528 505" fill="#adb0b6" />
    <path d="M 472 502 C 485 520, 515 520, 528 502" fill="none" stroke="#9da0a6" stroke-width="6" stroke-linecap="round" />

    <!-- MOUTH & TONGUE (Signature cheeky open smile :P) -->
    <g id="mouth" transform="translate(0, 10)">
      <!-- Dark Inside Mouth Cavity -->
      <path d="
        M 412 550 
        C 412 535, 588 535, 588 550 
        C 588 610, 550 655, 500 655 
        C 450 655, 412 610, 412 550 Z" 
        fill="#2b2d31" 
      />

      <!-- Top Teeth Strip (Crisp white rectangular curved band) -->
      <path d="
        M 445 550 
        C 460 562, 540 562, 555 550 
        L 555 565 
        C 540 575, 460 575, 445 565 Z" 
        fill="#ffffff" 
      />

      <!-- Sticking Out Tongue Shape -->
      <path d="
        M 462 575 
        C 462 575, 460 675, 500 675 
        C 540 675, 538 575, 538 575 Z" 
        fill="url(#tongueFill)" 
        stroke="#4a4c52" 
        stroke-width="4"
      />

      <!-- Tongue Center Groove Line -->
      <path d="M 500 585 L 500 645" fill="none" stroke="#3f4146" stroke-width="5" stroke-linecap="round" />
    </g>

    <!-- Soft Cheek Tone / Subtle Contours -->
    <ellipse cx="330" cy="530" rx="35" ry="20" fill="#caced4" opacity="0.3" />
    <ellipse cx="670" cy="530" rx="35" ry="20" fill="#caced4" opacity="0.3" />

  </g>
</svg>
